<!DOCTYPE html>
<!--
  介護施設・医療事務クリニック・児童発達支援施設の3社、生成AI活用研修アンケートの実施報告LP。
  受講者の声はアンケート原文からそのまま抜粋しています(氏名はアルファベットで匿名化済み)。
  数値スコアは各社アンケート(5点満点/一部10点満点)に基づく実データです。
-->
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>介護現場のAI活用研修 | 受講者の声とデータで見る効果</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌱</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FAF8F2; --surface:#FFFFFF; --text:#3B4D42; --text-soft:#82927E;
  --accent:#E29368; --teal:#7CB0A2; --border:#EAE6D8; --chip:#F3EFE1;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1B2620; --surface:#233128; --text:#EDF2E9; --text-soft:#A9BBA5;
    --accent:#EDA378; --teal:#8FC2B4; --border:#374A3E; --chip:#293A2F;
  }
}
:root[data-theme="dark"]{
  --bg:#1B2620; --surface:#233128; --text:#EDF2E9; --text-soft:#A9BBA5;
  --accent:#EDA378; --teal:#8FC2B4; --border:#374A3E; --chip:#293A2F;
}
*{box-sizing:border-box;}
body{margin:0;background:var(--bg);color:var(--text);font-family:'Zen Kaku Gothic New',sans-serif;line-height:1.8;}
h1,h2,.disp{font-family:'Zen Maru Gothic',sans-serif;}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px;}
a{color:inherit;}
img{max-width:100%;}

header{padding:22px 0;border-bottom:1px solid var(--border);}
.headbar{display:flex;justify-content:space-between;align-items:center;}
.brand{font-family:'Zen Maru Gothic',sans-serif;font-size:19px;letter-spacing:.02em;}
.cta-btn{background:var(--accent);color:#fff;padding:10px 20px;border-radius:3px;text-decoration:none;font-size:14px;white-space:nowrap;}

.hero{padding:64px 0 40px;}
.hero-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:44px;align-items:center;}
.hero h1{font-size:clamp(28px,4vw,40px);font-weight:700;line-height:1.55;margin:0 0 18px;}
.hero p.lead{color:var(--text-soft);font-size:16px;margin:0 0 28px;max-width:42ch;}
.quote-card{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--teal);padding:28px 26px;border-radius:2px;}
.quote-card p{font-size:17px;margin:0 0 12px;}
.quote-card .who{color:var(--text-soft);font-size:13px;}

.stat-strip{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface);}
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);}
.stat-item{padding:26px 20px;text-align:center;border-right:1px solid var(--border);}
.stat-item:last-child{border-right:none;}
.stat-num{font-family:'Zen Maru Gothic',sans-serif;font-size:32px;color:var(--teal);}
.stat-label{color:var(--text-soft);font-size:13px;margin-top:4px;}

section{padding:56px 0;}
h2{font-size:24px;font-weight:700;margin:0 0 8px;}
.section-sub{color:var(--text-soft);font-size:14px;margin:0 0 32px;}

.overview{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;}
.overview p{color:var(--text-soft);font-size:15px;}
.timeline{border-left:2px solid var(--border);padding-left:20px;}
.tl-item{position:relative;padding-bottom:22px;}
.tl-item:last-child{padding-bottom:0;}
.tl-item::before{content:attr(data-n);position:absolute;left:-33px;top:0;width:22px;height:22px;border-radius:50%;background:var(--teal);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center;}
.tl-item .tl-title{font-weight:700;font-size:15px;}
.tl-item .tl-desc{color:var(--text-soft);font-size:13.5px;}

.change-box{background:var(--surface);border:1px solid var(--border);border-radius:3px;padding:32px;}
.bar-row{margin-bottom:18px;}
.bar-row .bar-label{display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;}
.bar-track{background:var(--chip);border-radius:2px;height:14px;overflow:hidden;}
.bar-fill{height:100%;border-radius:2px;background:var(--teal);}
.bar-fill.after{background:var(--accent);}
.change-note{color:var(--text-soft);font-size:13.5px;margin-top:16px;}

.chips{display:flex;flex-wrap:wrap;gap:10px;}
.chip{background:var(--chip);border:1px solid var(--border);padding:8px 16px;border-radius:20px;font-size:14px;}

.testimonials{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.t-card{background:var(--surface);border:1px solid var(--border);padding:22px;border-radius:2px;}
.t-card p{font-size:14.5px;margin:0 0 10px;}
.t-card .who{color:var(--text-soft);font-size:12.5px;}

.callout{background:var(--chip);border:1px solid var(--border);border-radius:3px;padding:30px 32px;}
.callout h2{font-size:19px;}
.callout p{color:var(--text-soft);font-size:14.5px;margin:0;}

.cta-final{text-align:center;padding:60px 0 70px;}
.cta-final h2{font-size:26px;}
.cta-final p{color:var(--text-soft);max-width:38ch;margin:12px auto 26px;}

footer{border-top:1px solid var(--border);padding:26px 0;color:var(--text-soft);font-size:13px;}

@media (max-width:760px){
  .hero-grid,.overview,.testimonials{grid-template-columns:1fr;}
  .stat-grid{grid-template-columns:1fr;}
  .stat-item{border-right:none;border-bottom:1px solid var(--border);}
  .stat-item:last-child{border-bottom:none;}
}
.cta-btn.sub{background:transparent;color:var(--text);border:1px solid var(--border);}
.btn-row{display:flex;flex-wrap:wrap;gap:12px;}
.ep-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.ep{background:var(--surface);border:1px solid var(--border);border-radius:3px;padding:26px;}
.ep-tag{display:inline-block;background:var(--chip);color:var(--teal);font-size:12.5px;padding:3px 12px;border-radius:20px;margin-bottom:10px;}
.ep h3{font-family:'Zen Maru Gothic',sans-serif;font-size:18px;margin:0 0 10px;line-height:1.6;}
.ep-story{color:var(--text-soft);font-size:14.5px;margin:0 0 16px;}
.ep-answer{border-top:1px dashed var(--border);padding-top:14px;font-size:14.5px;}
.ep-answer b{color:var(--accent);display:block;font-size:13px;margin-bottom:4px;}
.flow{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;position:relative;margin-top:8px;}
.flow::before{content:"";position:absolute;top:34px;left:10%;right:10%;border-top:2px dashed var(--teal);opacity:.45;}
.flow-item{position:relative;text-align:center;padding:0 8px;}
.flow-ic{width:68px;height:68px;border-radius:50%;background:var(--surface);border:2px solid var(--teal);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;position:relative;z-index:1;}
.flow-ic svg{width:28px;height:28px;stroke:var(--teal);}
.flow-item.last .flow-ic{background:var(--accent);border-color:var(--accent);}
.flow-item.last .flow-ic svg{stroke:#fff;}
.flow-step{color:var(--accent);font-size:12px;letter-spacing:.14em;font-weight:700;margin-bottom:4px;}
.flow-item .t{font-weight:500;font-size:14px;line-height:1.7;}
@media (max-width:900px){
  .flow{grid-template-columns:1fr;gap:0;}
  .flow::before{top:34px;bottom:34px;left:33px;right:auto;border-top:none;border-left:2px dashed var(--teal);}
  .flow-item{display:grid;grid-template-columns:68px 1fr;gap:18px;text-align:left;align-items:center;padding:10px 0;}
  .flow-ic{margin:0;}
}
@media (max-width:760px){.ep-grid{grid-template-columns:1fr;}}
.wrap:not(.callout) > h2,.wrap:not(.callout) > .section-sub{text-align:center;}
.chips{justify-content:center;}
.change-note{text-align:center;}
</style>
